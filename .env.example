# Copy to .env and fill in. Never commit .env.

# --- Claude API (required at serving time; NOT needed for indexing) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANSWER_MODEL=claude-sonnet-4-6
VERIFIER_MODEL=claude-haiku-4-5
EXPANSION_MODEL=claude-haiku-4-5

# --- Qdrant ---
# Leave QDRANT_URL empty to use embedded local mode (dev without Docker).
# docker-compose sets this to http://qdrant:6333.
QDRANT_URL=
QDRANT_COLLECTION=verses

# --- Storage ---
SQLITE_PATH=data/verses.db

# --- Human gate on /chat (Cloudflare Turnstile; empty secret disables it) ---
# Create a Turnstile widget in the Cloudflare dashboard for the domain.
TURNSTILE_SITE_KEY=      # public, served to the page
TURNSTILE_SECRET=        # private, server-side siteverify
SESSION_SECRET=          # HMAC key for the human cookie: openssl rand -hex 32
# Keep true in prod (HTTPS via Cloudflare). Set false only for local http testing.
COOKIE_SECURE=true

# --- Cloudflare Tunnel ---
# Token from the Cloudflare dashboard (Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=
