# Copy to .env and fill in. Never commit .env.

# --- Claude API (required at serving time; NOT needed for indexing) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANSWER_MODEL=claude-sonnet-4-6
VERIFIER_MODEL=claude-haiku-4-5
EXPANSION_MODEL=claude-haiku-4-5

# --- Qdrant ---
# Leave QDRANT_URL empty to use embedded local mode (dev without Docker).
# docker-compose sets this to http://qdrant:6333.
QDRANT_URL=
QDRANT_COLLECTION=verses

# --- Storage ---
SQLITE_PATH=data/verses.db

# --- Access ---
# The app is open (no login). Protect the public /chat endpoint at the Cloudflare
# edge: Security > Bots > Bot Fight Mode (on) + a rate-limiting rule on /chat,
# plus an Anthropic monthly spend cap. No app-level auth settings needed.

# --- Cloudflare Tunnel ---
# Token from the Cloudflare dashboard (Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=

# --- Daily verse push notifications (off by default) ---
# Generate the secrets with: python scripts/gen_vapid_keys.py
# With PUSH_ENABLED=true the app refuses to start if any secret is missing or weak.
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_ADMIN_TOKEN=
PUSH_HMAC_KEY=
PUSH_ROTATION_SEED=
PUSH_DB_PATH=state/push.db
PUSH_DAILY_TIMES=08:30,17:30
PUSH_TIMEZONE=America/Los_Angeles
PUSH_ROTATION_START=2026-11-01
PUSH_MAX_DEVICES=5000
PUSH_SUBSCRIBE_RATE=5
PUSH_SUBSCRIBE_RATE_WIDE=30
PUSH_SIGNUP_BUDGET_PER_HOUR=100
PUSH_SIGNUP_IP_DAYS=7
PUSH_LOG_RETENTION_DAYS=90
QUOTE_AI_ENABLED=true
QUOTE_MODEL=claude-haiku-5-5
